rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }
    
    // Admin check: Hardcoded bootstrap email OR check admins collection
    function isAdmin() {
      return isSignedIn() && isVerified() && (
        request.auth.token.email == 'khalilah64780@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ---------------------------------------------------------
    // VALIDATION HELPERS
    // ---------------------------------------------------------
    
    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 5000
        && data.techStack is list && data.techStack.size() <= 20
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && data.featured is bool
        && data.createdAt is timestamp;
    }
    
    function isValidPricing(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.price is number && data.price >= 0
        && data.period in ['month', 'project']
        && data.features is list && data.features.size() <= 30
        && data.isPopular is bool
        && data.order is int;
    }
    
    function isValidContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.matches('.+@.+\\..+')
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && data.createdAt == request.time;
    }
    
    function isValidProfile(data) {
      return data.name is string && data.name.size() <= 100
        && data.bio is string && data.bio.size() <= 1000
        && data.avatarUrl is string && data.avatarUrl.size() <= 500;
    }

    // ---------------------------------------------------------
    // COLLECTIONS
    // ---------------------------------------------------------

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Projects
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProject(incoming());
      allow update: if isAdmin() && isValidProject(incoming());
      allow delete: if isAdmin();
    }

    // Pricing
    match /pricing/{tierId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPricing(incoming());
      allow update: if isAdmin() && isValidPricing(incoming());
      allow delete: if isAdmin();
    }

    // Contacts
    match /contacts/{contactId} {
      // Anyone can submit
      allow create: if isValidContact(incoming());
      // Only admins can manage
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProfile(incoming());
    }

    // Admins collection (to allow adding more admins)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
